{
  "name": "sf",
  "version": "0.1.0",
  "private": true,
  "description": "Build and run a software factory.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "sf": "./dist/sf.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "imports": {
    "#model/*": "./src/model/*.ts"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:(server|web)$/\"",
    "dev:server": "tsx watch src/cli/main.ts start --dev --port 4317 --token dev --no-open",
    "dev:web": "vite",
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && pnpm typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "sf:prod": "node dist/sf.mjs",
    "sf:dev": "node scripts/sf-dev.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "fuzzysort": "^4.0.2",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
